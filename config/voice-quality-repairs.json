      "input": "assets/voices/39b3376265a36e78d518c158a893a885a6783611f7237e4da139c5febfea0186.new-ally.mp3"
    },
    {
      "hash": "a5a94918c62c344b5dc3aba1c38e274403e2f0f29be97ea6dbf5f91987aeb674",
      "text": "ううん！ なんでもない♡",
      "speaker": "hostess",
      "trimEdges": true,
      "input": "assets/voices/a5a94918c62c344b5dc3aba1c38e274403e2f0f29be97ea6dbf5f91987aeb674.mp3"
    },
    {
      "hash": "a06d496176d8b600387b9b61d09623bc5488914efa0ac923ac6761591f6fcf02",
      "text": "えへへ……でも、大家さん、ちょっとカッコよかったよ♡",
