    },
    {
      "hash": "e65de566d3ec8feeaa8ab7e358ebd632a165c926d4d5a3dce1a6a17fcc13707d",
      "text": "大家さん！？",
      "speaker": "hostess",
      "trimEdges": true,
      "input": "assets/voices/e65de566d3ec8feeaa8ab7e358ebd632a165c926d4d5a3dce1a6a17fcc13707d.mp3"
    },
    {
      "hash": "ec077b05e77e32f10dac57db43011c119cc0a996c339e05e44bf3778b4e57f77",
      "text": "頼む……目を開けてくれ……！",
      "speaker": "manager",
      "trimEdges": true,
      "input": "assets/voices/ec077b05e77e32f10dac57db43011c119cc0a996c339e05e44bf3778b4e57f77.mp3"
    },
    {
      "hash": "e50eb1e52094905381bf0665c3d089deee901cae9993b431843c7c12fed2ebc5",
      "text": "あたしの未来、そんなふうに考えてくれるんだ。……大家さんの隣も、空けといてね♡",
      "speaker": "hostess",
      "trimEdges": true,
      "input": "assets/voices/e50eb1e52094905381bf0665c3d089deee901cae9993b431843c7c12fed2ebc5.mp3"
    },
    {
      "hash": "e7b66726d585e52e9e27c818a72499e8a370e46fdc17d45d5452f8cca32bb71e",
      "text": "最初からやれよ！",
      "speaker": "manager",
      "trimEdges": true,
      "input": "assets/voices/e7b66726d585e52e9e27c818a72499e8a370e46fdc17d45d5452f8cca32bb71e.mp3"
    },
    {
      "hash": "65897f1ec4f597b893a5bbcb7483bad1df07f2ad7059023cadab2710382b512f",
      "text": "変な大家ニャ。アパートは生き物じゃないニャ。",
      "speaker": "cat",
      "trimEdges": true,
      "input": "assets/voices/65897f1ec4f597b893a5bbcb7483bad1df07f2ad7059023cadab2710382b512f.mp3"
    },
    {
      "hash": "1677f500437761c4e8fe489ee585a446b00e19460a9b2d5ec0b116b6c00ed816",
      "text": "あの人、もう来ないといいな。",
      "speaker": "hostess",
      "trimEdges": true,
      "input": "assets/voices/1677f500437761c4e8fe489ee585a446b00e19460a9b2d5ec0b116b6c00ed816.mp3"
    },
    {
      "hash": "ff0836e79edc07b48321badf7818241ddaff1b8888ad340daf59274d8b219ed5",
      "text": "大家さんにも、ちゃんと相談しよう。",
      "speaker": "hostess",
      "trimEdges": true,
      "input": "assets/voices/ff0836e79edc07b48321badf7818241ddaff1b8888ad340daf59274d8b219ed5.mp3"
    },
    {
      "hash": "8f020a73376c68e41097fb5e40b751466dddc992cbb928d4d8d60fee8eedb565",
      "text": "……もう、お店は辞めたから。",
      "speaker": "hostess",
      "trimEdges": true,
      "input": "assets/voices/8f020a73376c68e41097fb5e40b751466dddc992cbb928d4d8d60fee8eedb565.mp3"
    },
    {
      "hash": "3b45be666ce71f9e839665f44b23374f747a201d4366e67c3b8eb0848ce30f84",
      "text": "……夢……だったのか……？",
      "speaker": "manager",
      "trimEdges": true,
      "input": "assets/voices/3b45be666ce71f9e839665f44b23374f747a201d4366e67c3b8eb0848ce30f84.mp3"
    },
    {
      "hash": "576dd180de95a09e85dae9ecb552a64edf4c93cdffe5ebb8b2eeb78d222845c8",
      "text": "……生きてる……。",
      "speaker": "manager",
      "trimEdges": true,
      "input": "assets/voices/576dd180de95a09e85dae9ecb552a64edf4c93cdffe5ebb8b2eeb78d222845c8.mp3"
    },
    {
      "hash": "dd2dcfa7da9cb881daee1e742e7658d1852f5f179e6e7c0b8feccad3079aca65",
      "text": "大家さん？ 何かあった？",
      "speaker": "hostess",
      "trimEdges": true,
      "input": "assets/voices/dd2dcfa7da9cb881daee1e742e7658d1852f5f179e6e7c0b8feccad3079aca65.mp3"
    },
    {
      "hash": "254d976eabda560b280766051c4c9d6e543c29a54646b840211bee2a5bb74308",
      "text": "……ずるいなぁ。",
      "speaker": "hostess",
      "trimEdges": true,
      "input": "assets/voices/254d976eabda560b280766051c4c9d6e543c29a54646b840211bee2a5bb74308.mp3"
    },
    {
      "hash": "8d63565482771caa5e0e54d932939b4bf3d6281115ec978f2d831f9e4f544698",
      "text": "……えっ？",
      "speaker": "hostess",
      "trimEdges": true,
      "input": "assets/voices/8d63565482771caa5e0e54d932939b4bf3d6281115ec978f2d831f9e4f544698.mp3"
    },
    {
      "hash": "64316f2da6c810976e424353d2a5133cb3268c950b60973a8b80a4c9f6f9ee2f",
      "text": "……大家さん？",
