      "input": "assets/voices/a06d496176d8b600387b9b61d09623bc5488914efa0ac923ac6761591f6fcf02.mp3"
    },
    {
      "hash": "e2045bbf14ce181df06f662a7d0cb40caddc66d25999d4b6d8d1c20f15323208",
      "text": "大家さん、今日は……助かった。",
      "speaker": "hostess",
