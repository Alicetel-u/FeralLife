      "input": "assets/voices/a1e4df631797e1cbb4d98204cf3e7ccc18d9d7104c1393722cf91dc7a4e70a43.mp3"
    },
    {
      "hash": "ff29cd05d7483e944b5918cd065444c599fd5e168bf464fcb6f47406b45b0983",
      "text": "好みの話が、いつの間にか婚姻届に……。",
      "speaker": "hostess",
      "trimEdges": true,
      "input": "assets/voices/ff29cd05d7483e944b5918cd065444c599fd5e168bf464fcb6f47406b45b0983.mp3"
    },
    {
      "hash": "8c348ce7e57f49e488bba9f1ac45bef8d3f97431457b063377862d1a6c8c9e12",
      "text": "……大家さん、すごい。あたしのために、あんなに必死になってくれるなんて……♡",
      "speaker": "hostess",
      "trimEdges": true,
      "input": "assets/voices/8c348ce7e57f49e488bba9f1ac45bef8d3f97431457b063377862d1a6c8c9e12.mp3"
    },
    {
      "hash": "8aa7d0c0abc7f8a583a2d1a634d0b780ed08efc679315c215a4ff42653b8dbaa",
      "text": "ねえ大家さん。これからも、ずーっと守ってくれるよね？♡",
