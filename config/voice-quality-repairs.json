      "input": "assets/voices/64316f2da6c810976e424353d2a5133cb3268c950b60973a8b80a4c9f6f9ee2f.mp3"
    },
    {
      "hash": "a1e4df631797e1cbb4d98204cf3e7ccc18d9d7104c1393722cf91dc7a4e70a43",
      "text": "ふーん。言い訳はできるんだ？",
      "speaker": "hostess",
